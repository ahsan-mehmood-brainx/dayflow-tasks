# Copy to `.env.local` to override locally (git-ignored).
# EXPO_PUBLIC_* values are inlined into the app bundle — never put secrets here.

# Which TaskRepository the dependency container provides: "mock" (default) or "api".
EXPO_PUBLIC_TASK_REPOSITORY=mock

# Required when EXPO_PUBLIC_TASK_REPOSITORY=api. No trailing slash needed.
# Android emulators reach the host machine at http://10.0.2.2:<port>.
EXPO_PUBLIC_API_BASE_URL=

# Optional. HTTP request timeout in milliseconds (default 10000).
EXPO_PUBLIC_API_TIMEOUT_MS=

# Optional. Simulated latency for the mock repository in milliseconds (default 350).
EXPO_PUBLIC_MOCK_LATENCY_MS=
